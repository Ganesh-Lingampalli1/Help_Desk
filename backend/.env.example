# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# JWT Configuration
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (MySQL)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=helpdesk_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/helpdesk_db

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880 # 5MB in bytes
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,docx,txt,zip

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# SLA Configuration (in hours)
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48
